# PostgreSQL (Phase 1). Host port 5544 avoids clashing with other local databases.
POSTGRES_DB=legacylift
POSTGRES_USER=legacylift
POSTGRES_PASSWORD=change-me-owner
POSTGRES_HOST_PORT=5544

# Role used by the application at runtime. It is not the table owner, is not a
# superuser, and cannot bypass Row Level Security.
APP_DB_USER=legacylift_app
APP_DB_PASSWORD=change-me-app

# Migrations connect as the owner role, the API and workers connect as the app role.
DATABASE_ADMIN_URL=postgresql+psycopg://legacylift:change-me-owner@localhost:5544/legacylift
DATABASE_URL=postgresql+psycopg://legacylift_app:change-me-app@localhost:5544/legacylift

# Authentication and security (Phase 2). Generate real values outside local use:
#   JWT_SECRET:             python -c "import secrets; print(secrets.token_urlsafe(48))"
#   UPLOAD_ENCRYPTION_KEY:  python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
# With ENVIRONMENT other than local or test the application refuses to start on the built in
# development values.
ENVIRONMENT=local
JWT_SECRET=
UPLOAD_ENCRYPTION_KEY=
COOKIE_SECURE=true
CORS_ORIGINS=http://localhost:5173
UPLOAD_DIR=./var/uploads
UPLOAD_MAX_BYTES=52428800
LOGIN_RATE_LIMIT=5/minute

# Demo users, local use only (registration is disabled). Run: cd backend && uv run python -m app.seed
SEED_ADMIN_PASSWORD=
SEED_ANALYST_PASSWORD=
SEED_VIEWER_PASSWORD=

# REA static analysis (Phase 4). Default: node rea-runner/wrapper.mjs (run `npm ci` in rea-runner first).
# Container mode: run the sandboxed image (docker build -t legacylift-rea-runner:6.7.0 rea-runner), for example
#   REA_COMMAND=docker run --rm --network none --read-only --user 10001:10001 --cap-drop ALL --tmpfs /tmp:size=64m,noexec,nosuid -v {workdir}:/work:ro legacylift-rea-runner:6.7.0
#   REA_CONTAINER_WORKDIR=/work
REA_COMMAND=
REA_TIMEOUT_SECONDS=120
REA_CONTAINER_WORKDIR=
REA_SAMPLE_ROWS=5

# Embeddings and mapping (Phase 6)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_CACHE_DIR=./var/models
# Thresholds written by `python -m app.mapping.tuning`; empty means backend/config/mapping_thresholds.json
MAPPING_THRESHOLDS_FILE=

# LLM router (Phase 7). Free tier content may be used by the provider to improve its products, so only synthetic or
# masked data is ever sent. Keys are read from the environment only. Leave them empty to run without an LLM.
GROQ_API_KEY=
GEMINI_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Confirm the current free models and quotas in Google AI Studio before choosing (a Flash-Lite class model is the safest start).
GEMINI_MODEL=gemini-2.5-flash-lite
LLM_PROVIDER_ORDER=groq,gemini
LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=800
LLM_JOB_TOKEN_BUDGET=6000
LLM_ORG_DAILY_TOKEN_BUDGET=100000
LLM_MAX_CALLS_PER_JOB=2
